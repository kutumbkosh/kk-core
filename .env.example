# ╔═══════════════════════════════════════════════════════════╗
# ║               KutumbKosh — Environment Variables          ║
# ║                                                          ║
# ║  Copy this file to .env.local and fill in your values.   ║
# ║  NEVER commit .env.local — it's in .gitignore.           ║
# ╚═══════════════════════════════════════════════════════════╝

# ─── Environment ──────────────────────────────────────────────
# Which environment this instance runs in.
# Values: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# ─── Supabase (REQUIRED) ─────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
#
# You need SEPARATE Supabase projects for each environment:
#   Dev:     kutumbkosh-dev
#   Staging: kutumbkosh-staging
#   Prod:    kutumbkosh-prod
#
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key — needed for account deletion (admin API).
# Get from: Supabase Dashboard → Settings → API → service_role (secret)
# NEVER expose this on the client side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── App Configuration ───────────────────────────────────────
NEXT_PUBLIC_APP_NAME=KutumbKosh
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Feature Flags ───────────────────────────────────────────
# Mock payments: Uses simulated payment flow instead of real Razorpay.
# Default: true in dev/staging, false in production.
# Override explicitly if needed:
# NEXT_PUBLIC_MOCK_PAYMENTS=true

# ─── Admin Emails ────────────────────────────────────────
# Comma-separated list of emails with admin dashboard access.
# Must also match supabase/admin-views.sql is_admin() function.
NEXT_PUBLIC_ADMIN_EMAILS=admin@kutumbkosh.com

# ─── Razorpay (Production only) ──────────────────────────────
# Required when NEXT_PUBLIC_MOCK_PAYMENTS=false
# Get these from: Razorpay Dashboard → Settings → API Keys
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your-secret-here

# ─── Email (Optional — for transactional emails) ─────────────
# Using Resend for magic link customization, reminders, etc.
# Not required for basic Supabase magic link auth.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@kutumbkosh.in

# ─── Error Monitoring (Sentry) ───────────────────────────────
# Sign up at https://sentry.io, create a Next.js project, copy the DSN.
# Get DSN from: Sentry Dashboard → Project Settings → Client Keys (DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oxxxxxx.ingest.sentry.io/xxxxxxx
#
# Required for source map uploads at build time (set in Vercel env vars):
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxx
# SENTRY_ORG=kutumbkosh
# SENTRY_PROJECT=kutumbkosh-web

# ─── Analytics (Cloudflare Web Analytics) ────────────────────
# Free forever. Setup: Cloudflare Dashboard → Web Analytics → Add a site → kutumbkosh.com
# Copy the beacon token and paste below.
# The analytics script is ONLY loaded in production (NEXT_PUBLIC_APP_ENV=production).
# NEXT_PUBLIC_CF_BEACON_TOKEN=your-beacon-token-here
